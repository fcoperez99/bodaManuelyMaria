---
const imagenBaluarte = "/Baluarte.jpg";
const lugar = "Baluarte de los Mártires";
const direccion = "C. Sacramento, 1, 11001 Cádiz";
const hora = "18:30 h";
const mapaUrl = "https://maps.google.com/?q=Baluarte+de+los+Mártires+Cadiz";
---

<section class="location-section">
  <div class="location-card">
    <div class="decorative-icon">✦</div>
    <h2>LUGAR DE LA CELEBRACIÓN</h2>

    <div class="image-wrapper">
      <img
        src={imagenBaluarte}
        alt="Ilustración Baluarte de los Mártires"
        class="baluarte-img"
      />
    </div>

    <div class="details">
      <h3 class="lugar-nombre">{lugar}</h3>
      <p class="hora">🕗 {hora}</p>
      <p class="direccion">{direccion}</p>

      <a
        href={mapaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="map-button"
      >
        CÓMO LLEGAR EN GOOGLE MAPS
      </a>
    </div>
  </div>
</section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500&display=swap");

  .location-section {
    background-color: #fdfcf8;
    padding: 4rem 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: "Montserrat", sans-serif;
  }

  /* Marco unificado igual que la cuenta atrás */
  .location-card {
    background: #ffffff;
    border: 1px solid #e8dfd8;
    border-radius: 20px;
    padding: 3rem 2rem;
    max-width: 580px; /* Mismo ancho exactamente */
    width: 100%;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .decorative-icon {
    color: #c5a059;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.8rem;
    letter-spacing: 3px;
    color: #2c2c2c;
    margin: 0 0 1.5rem 0;
    font-weight: 500;
  }

  /* Contenedor de la ilustración encajado dentro de la tarjeta con bordes suaves */
  .image-wrapper {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .baluarte-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .details {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lugar-nombre {
    font-family: "Cormorant Garamond", serif;
    font-size: 2rem;
    color: #2c2c2c;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .hora {
    font-size: 0.95rem;
    color: #4a4a4a;
    font-weight: 500;
    margin: 0 0 0.3rem 0;
  }

  .direccion {
    color: #8c857b;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    margin: 0 0 2rem 0;
  }

  .map-button {
    display: inline-block;
    background-color: #2c2c2c;
    color: #ffffff;
    text-decoration: none;
    padding: 0.9rem 1.8rem;
    border-radius: 30px;
    font-size: 0.75rem;
    letter-spacing: 1.5px;
    font-weight: 500;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 320px;
    box-sizing: border-box;
  }

  .map-button:hover {
    background-color: #c5a059;
    transform: translateY(-2px);
  }

  /* Ajustes para móviles */
  @media (max-width: 480px) {
    .location-card {
      padding: 2rem 1.2rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    .lugar-nombre {
      font-size: 1.6rem;
    }
  }
</style>
